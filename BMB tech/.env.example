# Add these in Netlify: Site configuration > Environment variables
# (for local testing with `netlify dev`, copy this file to .env)

# Email: where enquiries are sent, and the SMTP account that sends them
MAIL_TO=hello@yourdomain.com
MAIL_FROM="BMB Tech Firm <no-reply@yourdomain.com>"
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Long random string to read saved messages at /api/admin/messages
ADMIN_TOKEN=change-me-to-a-long-random-string

# Optional automatic WhatsApp alert (WhatsApp Business Cloud API from Meta)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# Your number that receives alerts: digits with country code, e.g. 233201234567
WHATSAPP_TO=
# Approved message template with 5 body variables: name, email, service, budget, message
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=en
